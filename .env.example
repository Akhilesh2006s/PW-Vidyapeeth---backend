# Copy this file to .env and fill in the values.
# Never commit .env. Never put these values in frontend code.

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string.
# Any one of these names is accepted: MONGODB_URI, MONGO_URI, MONGODB_URL
MONGODB_URI=
# MONGO_URI=
# MONGODB_URL=

# Long random string used to sign login tokens.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Directory for counselling recordings. Relative paths are resolved from back-end/.
UPLOAD_DIR=uploads

# AI provider. auto uses Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI when AI_API_KEY is set.
# Other values: anthropic | openai | http | stub
AI_PROVIDER=anthropic
AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_API_BASE_URL=https://api.openai.com/v1
AI_TRANSCRIBE_MODEL=whisper-1
AI_ANALYSIS_MODEL=claude-sonnet-5

# Optional demo data. Run `npm run seed` after the database URL is set.
SEED_COUNSELLOR_EMAIL=counsellor@physicswallah.local
SEED_COUNSELLOR_PASSWORD="PhysicsWallah#2026"
SEED_ADMIN_EMAIL=admin@physicswallah.local
SEED_ADMIN_PASSWORD="PhysicsWallah#2026"
